#!/usr/bin/env bash
# Restricted production gateway of the Telegram application.
#
# SSH forced command of inside-telegram-deploy runs it as root through one sudoers rule:
#   deploy <vN> <github-run-id>    rollback <vN> <github-run-id>
# stdin: gzip tar with exactly release-manifest.json, compose.yaml and telegram.caddy of that release.
# Host-owned /etc/inside/telegram/{compose.env,compose.override.yaml,application.env} are only read.
set -euo pipefail

if [[ -n "${INSIDE_TELEGRAM_DEPLOY_TEST_ROOT:-}" ]]; then
  if [[ "$EUID" -eq 0 ]]; then
    echo "Test root is forbidden for a root process" >&2
    exit 1
  fi
  host_root="${INSIDE_TELEGRAM_DEPLOY_TEST_ROOT%/}"
  readiness_attempts=2
  readiness_delay=0
else
  if [[ "$EUID" -ne 0 ]]; then
    echo "inside-telegram-deploy must run as root" >&2
    exit 1
  fi
  host_root=""
  readiness_attempts=20
  readiness_delay=3
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
fi

readonly github_repository=sachkov-inside/inside-telegram
readonly image_pattern='^ghcr\.io/sachkov-inside/inside-telegram@sha256:[0-9a-f]{64}$'
readonly version_pattern='^v[1-9][0-9]*$'
readonly digest_pattern='^sha256:[0-9a-f]{64}$'
config_dir="$host_root/etc/inside/telegram"
releases_dir="$host_root/srv/inside/telegram/releases"
state_dir="$host_root/var/lib/inside/telegram-deployments"
state_file="$state_dir/state.json"
operation_file="$state_dir/operation.json"
# Written before migrations and removed only by a successful operation, so it survives a killed run.
migration_guard="$state_dir/migration-guard.json"
caddyfile="$host_root/etc/caddy/Caddyfile"
caddy_dir="$host_root/srv/inside/runtime/caddy"
caddy_target="$caddy_dir/telegram.caddy"
# Neither name ends in .caddy, so the host Caddyfile glob never imports them.
caddy_previous="$caddy_dir/telegram.caddy.previous"
caddy_temporary="$caddy_dir/.telegram.caddy.tmp.$$"

read -r operation version run_id extra <<<"${SSH_ORIGINAL_COMMAND:-}" || true
if [[ -n "${extra:-}" || ! "${operation:-}" =~ ^(deploy|rollback)$ ||
      ! "${version:-}" =~ $version_pattern || ! "${run_id:-}" =~ ^[1-9][0-9]*$ ]]; then
  echo "Rejected restricted command; expected: deploy|rollback vN <github-run-id>" >&2
  exit 2
fi

install -d -m 700 "$state_dir"
install -d -m 755 "$releases_dir"
incoming_dir="$(mktemp -d "$state_dir/incoming.XXXXXX")"
staged=""
cleanup() {
  local status=$?
  trap - EXIT
  for directory in "$incoming_dir" "$staged"; do
    if [[ -n "$directory" && -d "$directory" ]]; then
      rm -r "$directory"
    fi
  done
  rm -f "$caddy_temporary"
  exit "$status"
}
trap cleanup EXIT

file_size() {
  wc -c <"$1" | tr -d ' '
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

now() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

ordinal() {
  echo "${1#v}"
}

# Reads at most limit+1 bytes, so an oversized input is refused without being truncated into validity.
read_limited() {
  local destination="$1" limit="$2" label="$3"
  if ! head -c "$((limit + 1))" >"$destination"; then
    echo "$label cannot be read" >&2
    exit 1
  fi
  if [[ "$(file_size "$destination")" -gt "$limit" ]]; then
    echo "$label exceeds $limit bytes" >&2
    exit 1
  fi
}

# The payload is read completely before the lock, so a stalled client cannot hold it.
payload="$incoming_dir/payload.tar.gz"
read_limited "$payload" 1048576 "Deployment payload"
if ! gzip -dc "$payload" 2>/dev/null | read_limited "$incoming_dir/payload.tar" 4194304 "Decoded payload"; then
  echo "Deployment payload is not a valid gzip archive within its limit" >&2
  exit 1
fi
if [[ "$(tar -tf "$incoming_dir/payload.tar" 2>/dev/null | LC_ALL=C sort | tr '\n' ' ')" != "compose.yaml release-manifest.json telegram.caddy " ]]; then
  echo "Payload must contain only release-manifest.json, compose.yaml and telegram.caddy" >&2
  exit 1
fi
if [[ "$(tar -tvf "$incoming_dir/payload.tar" | cut -c 1 | LC_ALL=C sort -u)" != - ]]; then
  echo "Deployment payload entries must be regular files" >&2
  exit 1
fi
manifest="$incoming_dir/release-manifest.json"
compose_file="$incoming_dir/compose.yaml"
caddy_file="$incoming_dir/telegram.caddy"
tar -xOf "$incoming_dir/payload.tar" release-manifest.json |
  read_limited "$manifest" 65536 "Release manifest"
tar -xOf "$incoming_dir/payload.tar" compose.yaml |
  read_limited "$compose_file" 262144 "Release compose file"
tar -xOf "$incoming_dir/payload.tar" telegram.caddy |
  read_limited "$caddy_file" 65536 "Release Caddy fragment"
rm "$payload" "$incoming_dir/payload.tar"

lock_file="$state_dir/operation.lock"
: >>"$lock_file"
chmod 600 "$lock_file"
exec 9<>"$lock_file"
if ! flock --exclusive --nonblock 9; then
  echo "Another Telegram production operation is active" >&2
  exit 1
fi

if ! jq --exit-status \
  --arg version "$version" \
  --arg repository "$github_repository" \
  --arg imagePattern "$image_pattern" \
  --arg digestPattern "$digest_pattern" '
  (keys == ["caddy", "compose", "image", "migrations", "publication", "schemaVersion", "source", "version"]) and
  .schemaVersion == "inside.telegram.release-manifest.v1" and
  .version == $version and
  (.source | keys == ["repository", "sha"]) and
  .source.repository == $repository and
  (.source.sha | test("^[0-9a-f]{40}$")) and
  (.image | test($imagePattern)) and
  (.migrations | keys == ["count", "identity", "latest"]) and
  (.migrations.identity | test($digestPattern)) and
  (.migrations.count | type == "number" and . >= 1 and floor == .) and
  (.migrations.latest | type == "string") and
  (.compose | keys == ["asset", "sha256"]) and
  .compose.asset == "compose.yaml" and
  (.compose.sha256 | test($digestPattern)) and
  (.caddy | keys == ["asset", "sha256"]) and
  .caddy.asset == "telegram.caddy" and
  (.caddy.sha256 | test($digestPattern)) and
  (.publication | keys == ["workflowRunId", "workflowRunUrl"]) and
  (.publication.workflowRunId | type == "number" and . > 0 and floor == .) and
  .publication.workflowRunUrl == ("https://github.com/" + $repository + "/actions/runs/" + (.publication.workflowRunId | tostring))
' "$manifest" >/dev/null 2>&1; then
  echo "Release manifest does not satisfy the Telegram production contract" >&2
  exit 1
fi
if [[ "sha256:$(sha256_file "$compose_file")" != "$(jq --raw-output .compose.sha256 "$manifest")" ]]; then
  echo "Release compose file does not match its manifest" >&2
  exit 1
fi
if [[ "sha256:$(sha256_file "$caddy_file")" != "$(jq --raw-output .caddy.sha256 "$manifest")" ]]; then
  echo "Release Caddy fragment does not match its manifest" >&2
  exit 1
fi

github_get() {
  local url="$1" destination="$2" accept="${3:-application/vnd.github+json}"
  curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --connect-timeout 10 \
    --max-time 60 \
    --retry 2 \
    --retry-delay 1 \
    --proto '=https' \
    --proto-redir '=https' \
    --header "Accept: $accept" \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    --user-agent inside-telegram-deployer \
    --output "$destination" \
    "$url"
}

# The payload is trusted only when it is byte-identical to the asset of the immutable release.
source_sha="$(jq --raw-output .source.sha "$manifest")"
download_base="https://github.com/$github_repository/releases/download/$version"
github_get "https://api.github.com/repos/$github_repository/releases/tags/$version" \
  "$incoming_dir/github-release.json"
github_get "$download_base/release-manifest.json" \
  "$incoming_dir/github-release-manifest.json" application/octet-stream
if ! jq --exit-status \
  --arg version "$version" \
  --arg sourceSha "$source_sha" \
  --arg base "$download_base" '
    def url(name): [.assets[] | select(.name == name)][0].browser_download_url;
    .immutable == true and
    .draft == false and
    .prerelease == false and
    .tag_name == $version and
    .target_commitish == $sourceSha and
    ([.assets[].name] | sort) == ["compose.yaml", "release-manifest.json", "telegram.caddy"] and
    url("release-manifest.json") == ($base + "/release-manifest.json") and
    url("compose.yaml") == ($base + "/compose.yaml") and
    url("telegram.caddy") == ($base + "/telegram.caddy")
  ' "$incoming_dir/github-release.json" >/dev/null 2>&1 ||
  ! cmp -s "$manifest" "$incoming_dir/github-release-manifest.json"; then
  echo "Deployment payload does not match the immutable GitHub release $version" >&2
  exit 1
fi
publication_run_id="$(jq --raw-output .publication.workflowRunId "$manifest")"
github_get "https://api.github.com/repos/$github_repository/actions/runs/$publication_run_id" \
  "$incoming_dir/publication-run.json"
if ! jq --exit-status \
  --arg sourceSha "$source_sha" \
  --argjson runId "$publication_run_id" '
    .id == $runId and
    .conclusion == "success" and
    .event == "workflow_dispatch" and
    .head_branch == "main" and
    .head_sha == $sourceSha and
    .path == ".github/workflows/release.yml"
  ' "$incoming_dir/publication-run.json" >/dev/null 2>&1; then
  echo "Release publication workflow run is not verified" >&2
  exit 1
fi

image="$(jq --raw-output .image "$manifest")"
migrations_identity="$(jq --raw-output .migrations.identity "$manifest")"
manifest_sha="sha256:$(sha256_file "$manifest")"
started_at="$(now)"
phase=preflight
containers=""

refuse() {
  echo "$1" >&2
  exit 1
}

if [[ -f "$state_file" ]] && ! jq --exit-status \
  --arg versionPattern "$version_pattern" \
  --arg digestPattern "$digest_pattern" '
  def entry: type == "object" and
    (.version | type == "string" and test($versionPattern)) and
    (.migrationsIdentity | type == "string" and test($digestPattern)) and
    (.manifestSha256 | type == "string" and test($digestPattern));
  .schemaVersion == "inside.telegram.deployment-state.v1" and
  (.current | entry) and
  (.previous == null or (.previous | entry))
' "$state_file" >/dev/null 2>&1; then
  refuse "Deployment state $state_file is invalid; repair it before any operation"
fi
if [[ -f "$migration_guard" ]] && ! jq --exit-status \
  --arg versionPattern "$version_pattern" \
  --arg digestPattern "$digest_pattern" '
  (.version | type == "string" and test($versionPattern)) and
  (.migrationsIdentity | type == "string" and test($digestPattern))
' "$migration_guard" >/dev/null 2>&1; then
  refuse "Migration guard $migration_guard is invalid; repair it before any operation"
fi

record_operation() {
  local status="$1" message="${2:-}"
  local temporary="$operation_file.tmp.$$"
  jq --null-input \
    --arg operation "$operation" \
    --arg version "$version" \
    --arg image "$image" \
    --arg migrations "$migrations_identity" \
    --argjson runId "$run_id" \
    --arg phase "$phase" \
    --arg status "$status" \
    --arg message "$message" \
    --arg containers "$containers" \
    --arg startedAt "$started_at" \
    --arg updatedAt "$(now)" '{
      schemaVersion: "inside.telegram.deployment-operation.v1",
      operation: $operation,
      version: $version,
      image: $image,
      migrationsIdentity: $migrations,
      githubRunId: $runId,
      phase: $phase,
      status: $status,
      message: (if $message == "" then null else $message end),
      containers: (if $containers == "" then null else ($containers | split("\n")) end),
      startedAt: $startedAt,
      updatedAt: $updatedAt
    }' >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$operation_file"
}

active_compose="$compose_file"
compose() {
  TELEGRAM_IMAGE="$image" docker compose \
    --env-file "$config_dir/compose.env" \
    -f "$active_compose" \
    -f "$config_dir/compose.override.yaml" \
    "$@"
}

enter_phase() {
  phase="$1"
  record_operation running
}

fail() {
  # Service states only: container logs may carry provider payloads and stay in docker logs.
  containers="$(compose ps --all --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null || true)"
  record_operation failed "$1"
  echo "$operation $version failed in phase $phase: $1" >&2
  echo "Diagnostics: $operation_file. The gateway did not delete data or volumes." >&2
  exit 1
}

current_version=""
current_migrations=""
if [[ -f "$state_file" ]]; then
  current_version="$(jq --raw-output .current.version "$state_file")"
  current_migrations="$(jq --raw-output .current.migrationsIdentity "$state_file")"
fi

# An unfinished operation that reached its migrations may have left the schema of its release.
# Only a newer deploy (repair forward) or an operation with the same migration set may follow it.
if [[ -f "$migration_guard" && "$(jq --raw-output .migrationsIdentity "$migration_guard")" != "$migrations_identity" ]]; then
  guarded_version="$(jq --raw-output .version "$migration_guard")"
  if [[ "$operation" != deploy || "$(ordinal "$version")" -le "$(ordinal "$guarded_version")" ]]; then
    refuse "Refusing $operation $version: an unfinished operation of $guarded_version may have migrated the database. Repair forward with a release newer than $guarded_version."
  fi
fi

same_release=false
if [[ "$version" == "$current_version" ]]; then
  if [[ "$(jq --raw-output .current.manifestSha256 "$state_file")" != "$manifest_sha" ]]; then
    refuse "Refusing $operation $version: the deployed $version has a different manifest"
  fi
  same_release=true
elif [[ "$operation" == deploy ]]; then
  if [[ -n "$current_version" && "$(ordinal "$version")" -le "$(ordinal "$current_version")" ]]; then
    refuse "Refusing deploy $version: current is $current_version; use rollback for the previous release"
  fi
else
  if [[ -z "$current_version" ]]; then
    refuse "Refusing rollback $version: nothing was deployed by this gateway yet"
  fi
  if ! jq --exit-status --arg version "$version" '.previous != null and .previous.version == $version' \
    "$state_file" >/dev/null; then
    refuse "Refusing rollback $version: only the recorded previous release can be restored ($(jq --raw-output '.previous.version // "none"' "$state_file"))"
  fi
  if [[ "$(jq --raw-output .previous.manifestSha256 "$state_file")" != "$manifest_sha" ]]; then
    refuse "Refusing rollback $version: the release differs from the recorded previous deployment"
  fi
  if [[ "$migrations_identity" != "$current_migrations" ]]; then
    refuse "Refusing rollback $current_version -> $version: migration sets differ and down migrations are not supported. Repair forward with the next release."
  fi
fi

release_dir="$releases_dir/$version"
if [[ -d "$release_dir" ]] &&
   { ! cmp -s "$release_dir/release-manifest.json" "$manifest" ||
     ! cmp -s "$release_dir/compose.yaml" "$compose_file" ||
     ! cmp -s "$release_dir/telegram.caddy" "$caddy_file"; }; then
  refuse "Refusing to replace the already staged release $version"
fi

record_operation running
for required in compose.env application.env compose.override.yaml; do
  if [[ ! -f "$config_dir/$required" || -L "$config_dir/$required" ]]; then
    fail "Host configuration $config_dir/$required is missing"
  fi
done
if [[ ! -f "$caddyfile" || ! -d "$caddy_dir" ]]; then
  fail "Host Caddy configuration $caddyfile or $caddy_dir is missing"
fi
compose config --quiet || fail "Compose configuration is invalid"
published_port="$(compose config --format json 2>/dev/null |
  jq --raw-output '[.services.app.ports[]? | select(.target == 3002) | .published | tostring] | first // empty')" ||
  fail "The app port cannot be read from the Compose configuration"
if [[ ! "$published_port" =~ ^[0-9]+$ ]] ||
   ! grep -Eq "^[[:space:]]*reverse_proxy 127\.0\.0\.1:${published_port}[[:space:]]*$" "$caddy_file"; then
  fail "telegram.caddy does not proxy to the app port 127.0.0.1:${published_port:-unknown}"
fi

enter_phase pull
docker pull --quiet "$image" >/dev/null || fail "Image $image cannot be pulled"

# Stage the exact release files; an ordinal is never re-staged with different content.
enter_phase stage
if [[ ! -d "$release_dir" ]]; then
  staged="$(mktemp -d "$releases_dir/.staging.XXXXXX")"
  install -m 644 "$manifest" "$staged/release-manifest.json"
  install -m 644 "$compose_file" "$staged/compose.yaml"
  install -m 644 "$caddy_file" "$staged/telegram.caddy"
  chmod 755 "$staged"
  mv "$staged" "$release_dir"
  staged=""
fi
active_compose="$release_dir/compose.yaml"

app_port=""
readiness() {
  local binding attempt code=""
  binding="$(compose port app 3002)" || return 1
  app_port="${binding##*:}"
  if [[ "${binding%:*}" != 127.0.0.1 || ! "$app_port" =~ ^[0-9]+$ ]]; then
    echo "app must publish only on 127.0.0.1, got $binding" >&2
    return 1
  fi
  for ((attempt = 1; attempt <= readiness_attempts; attempt += 1)); do
    code="$(curl --silent --output /dev/null --max-time 5 --write-out '%{http_code}' \
      "http://127.0.0.1:$app_port/ready" || true)"
    if [[ "$code" == 200 ]]; then
      return 0
    fi
    sleep "$readiness_delay"
  done
  echo "GET /ready answered $code after $readiness_attempts attempts" >&2
  return 1
}

caddy_log="$state_dir/caddy-last.log"
# Caddy output stays on the host: the shared Caddyfile also describes other applications.
caddy_run() {
  caddy "$@" --config "$caddyfile" --adapter caddyfile >"$caddy_log" 2>&1
}

restore_routes() {
  if [[ -f "$caddy_previous" ]]; then
    mv "$caddy_previous" "$caddy_target"
  else
    rm -f "$caddy_target"
  fi
}

# Installs the release Caddy fragment atomically; a rejected fragment restores the previous one.
activate_routes() {
  local fragment="$release_dir/telegram.caddy"
  if [[ "$app_port" != "$published_port" ]]; then
    echo "app publishes $app_port, but the Compose configuration declares $published_port" >&2
    return 1
  fi
  if cmp -s "$fragment" "$caddy_target"; then
    return 0
  fi
  rm -f "$caddy_previous" || return 1
  if [[ -f "$caddy_target" ]]; then
    cp -p "$caddy_target" "$caddy_previous" || return 1
  fi
  install -m 644 "$fragment" "$caddy_temporary" || return 1
  if ! mv "$caddy_temporary" "$caddy_target"; then
    rm -f "$caddy_previous"
    return 1
  fi
  if ! caddy_run validate; then
    restore_routes || return 1
    echo "Caddy rejected telegram.caddy of $version; the previous fragment is back, Caddy was not reloaded. Details: $caddy_log" >&2
    return 1
  fi
  if ! caddy_run reload; then
    restore_routes || return 1
    caddy_run reload || echo "Caddy reload with the restored fragment failed too" >&2
    echo "Caddy reload failed; the previous fragment is restored and reloaded. Details: $caddy_log" >&2
    return 1
  fi
  rm -f "$caddy_previous"
}

if [[ "$same_release" == true ]]; then
  # Repeating the operation converges on the recorded release without stopping or migrating.
  enter_phase start
  compose up --detach --no-build --wait app || fail "app did not start"
  enter_phase readiness
  readiness || fail "app is not ready"
  enter_phase routes
  activate_routes || fail "Caddy routes were not activated"
  rm -f "$migration_guard"
  phase=complete
  record_operation succeeded "$version is already current; app is running and ready"
  echo "$version is already current; app is running and ready."
  exit 0
fi

enter_phase stop
compose stop app || fail "The running app cannot be stopped"

if [[ "$operation" == deploy ]]; then
  enter_phase migrate
  temporary="$migration_guard.tmp.$$"
  jq --null-input --arg version "$version" --arg migrations "$migrations_identity" \
    '{version: $version, migrationsIdentity: $migrations}' >"$temporary"
  mv "$temporary" "$migration_guard"
  compose --profile operations run --rm --interactive=false migrate </dev/null ||
    fail "Migrations failed; app stays stopped"
fi

enter_phase start
compose up --detach --no-build --wait app || fail "app did not start"

enter_phase readiness
readiness || fail "app is not ready"

enter_phase routes
activate_routes || fail "Caddy routes were not activated"

enter_phase state
entry="$(jq --null-input \
  --arg version "$version" \
  --arg sourceSha "$source_sha" \
  --arg image "$image" \
  --arg migrations "$migrations_identity" \
  --arg manifestSha "$manifest_sha" \
  --arg operation "$operation" \
  --argjson runId "$run_id" \
  --arg at "$(now)" '{
    version: $version,
    sourceSha: $sourceSha,
    image: $image,
    migrationsIdentity: $migrations,
    manifestSha256: $manifestSha,
    operation: $operation,
    githubRunId: $runId,
    completedAt: $at
  }')"
if [[ "$operation" == deploy && -f "$state_file" ]]; then
  previous="$(jq --compact-output .current "$state_file")"
else
  # A first deploy has nothing to return to; after a rollback the next step is a new deploy.
  previous=null
fi
temporary="$state_file.tmp.$$"
jq --null-input --argjson current "$entry" --argjson previous "$previous" '{
  schemaVersion: "inside.telegram.deployment-state.v1",
  current: $current,
  previous: $previous
}' >"$temporary"
chmod 600 "$temporary"
mv "$temporary" "$state_file"
rm -f "$migration_guard"

phase=complete
record_operation succeeded
echo "$operation $version succeeded: $image"
