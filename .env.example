# Telegram application configuration. Production copies this file to
# /etc/inside/telegram/application.env (root, mode 0600) and replaces every value.
# All values below are synthetic. Real tokens, secrets, chat and user ids never enter Git.
# Every service secret is a separate random base64url value of 32-256 characters;
# startup rejects a shorter secret and any reuse between directions.

# --- Process -----------------------------------------------------------------
DATABASE_URL=postgresql://inside:inside@127.0.0.1:5433/inside_telegram
HOST=127.0.0.1
PORT=3002
# Background workers: webhook inbox, replies, reconciliation, community, notifications, funnels.
WORKERS_ENABLED=true

# --- Bot and canonical chat --------------------------------------------------
TELEGRAM_BOT_IDENTITY=inside
# The one shared community group. Production value comes from the owner, never from Git.
TELEGRAM_CANONICAL_CHAT_ID=-1000000000000
# Required when any *_MODE below is live. Live Telegram access remains an owner gate.
# TELEGRAM_BOT_TOKEN=
# Base64url alphabet, 32-256 characters; also the setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
# disabled stores intent without sending; live sends private-chat replies.
TELEGRAM_DELIVERY_MODE=disabled

# --- Private-chat texts (Russian; the owner owns final copy) ------------------
TELEGRAM_WELCOME_TEXT=Добро пожаловать в Sachkov Inside.
TELEGRAM_LINK_RECEIPT_TEXT=Подключаем Telegram. Вернитесь на платформу — всё завершится автоматически.
TELEGRAM_LINKED_MEMBER_TEXT=Готово! Telegram подключён ✅
TELEGRAM_LINKED_NON_MEMBER_TEXT=Готово! Telegram подключён ✅
TELEGRAM_LINKED_UNAVAILABLE_TEXT=Готово! Telegram подключён ✅

# --- Account linking (Platform -> Telegram) -----------------------------------
# Equals Platform TELEGRAM_LINKING_SECRET.
PLATFORM_INTEGRATION_SECRET=replace_with_separate_random_secret

# --- Communications API (Platform -> Telegram) ---------------------------------
# Authenticates /integrations/platform/v1/communications; equals Platform
# TELEGRAM_COMMUNICATIONS_SECRET. Absent: the communications API answers 401.
# PLATFORM_COMMUNICATIONS_SECRET=

# --- Membership evidence (Telegram -> Platform) --------------------------------
TELEGRAM_MEMBERSHIP_MODE=disabled
TELEGRAM_MEMBERSHIP_RECONCILIATION_CADENCE_MS=240000
# Days a superseded check result and its delivered evidence are kept (30..3650).
TELEGRAM_MEMBERSHIP_CHECK_RETENTION_DAYS=90
PLATFORM_EVIDENCE_DELIVERY_MODE=disabled
# Required only when PLATFORM_EVIDENCE_DELIVERY_MODE=live. Secret equals Platform
# TELEGRAM_EVIDENCE_INGRESS_SECRET.
# PLATFORM_EVIDENCE_DELIVERY_URL=https://platform.example.test/integrations/telegram/v1/membership-evidence
# PLATFORM_EVIDENCE_DELIVERY_SECRET=

# --- Sign-in through the bot ---------------------------------------------------
TELEGRAM_SIGN_IN_ENABLED=false
# Required only when sign-in is enabled; equals Platform and Logto TELEGRAM_SIGN_IN_INTEGRATION_SECRET.
# TELEGRAM_SIGN_IN_INTEGRATION_SECRET=

# --- Community v2 (Platform -> Telegram, Telegram -> Platform dispatch) -------
# Startup refuses any other version, and refuses a configured community without this line.
TELEGRAM_COMMUNITY_CONTRACT_VERSION=inside.community-entitlement.v2
TELEGRAM_COMMUNITY_MODE=disabled
TELEGRAM_COMMUNITY_RECONCILIATION_CADENCE_MS=60000
# Stays false until members are migrated (#150): the Inside bot never removes anyone.
TELEGRAM_COMMUNITY_REMOVALS_ENABLED=false
# Numeric Telegram user id of the Tribute bot. Its removals end only the Tribute basis:
# a person with a current Platform right is unbanned and invited back. Real id stays out of Git.
# TELEGRAM_COMMUNITY_TRIBUTE_BOT_ID=
# Equals Platform TELEGRAM_COMMUNITY_ENTITLEMENT_SECRET.
# PLATFORM_COMMUNITY_INTEGRATION_SECRET=
# PLATFORM_COMMUNITY_DISPATCH_URL=https://platform.example.test/internal/billing-dispatch/authorize
# Equals Platform TELEGRAM_COMMUNITY_DISPATCH_SECRET.
# PLATFORM_COMMUNITY_DISPATCH_SECRET=
# Private-chat wording for /community and the return invite. Defaults are Russian.
# TELEGRAM_COMMUNITY_INVITE_TEXT=
# TELEGRAM_COMMUNITY_PREPARING_TEXT=
# TELEGRAM_COMMUNITY_MEMBER_TEXT=
# TELEGRAM_COMMUNITY_UNAVAILABLE_TEXT=
# TELEGRAM_COMMUNITY_READMISSION_TEXT=

# --- Course and Tribute activation (Telegram -> Platform) ---------------------
TELEGRAM_ACTIVATION_ENABLED=false
# Required when activation is enabled. Secret equals Platform TELEGRAM_ACTIVATION_INGRESS_SECRET.
# PLATFORM_ACTIVATION_URL=https://platform.example.test/integrations/telegram/v1/subscription-activation
# PLATFORM_ACTIVATION_SECRET=
# Plain browser Account URL without token, query or fragment.
# PLATFORM_ACCOUNT_URL=https://platform.example.test/account
# JSON registry of course source groups; chat ids and confirmed lists stay in protected config.
# TELEGRAM_ACTIVATION_SOURCES=[{"sourceRef":"course","chatId":"-1000000000001","policy":"whole_group"}]

# --- Notifications through RabbitMQ (Platform -> Telegram) --------------------
TELEGRAM_NOTIFICATIONS_ENABLED=false
# Required when notifications are enabled. AMQPS with the Telegram principal and environment vhost.
# NOTIFICATION_AMQP_URL=amqps://telegram-principal:password@broker.example.test:5671/inside-production
# NOTIFICATION_AUTHORIZE_URL=https://platform.example.test/internal/notifications/dispatch/authorize
# Equals Platform NOTIFICATIONS_TELEGRAM_SECRET.
# NOTIFICATION_AUTHORIZE_SECRET=
# 64 lowercase hex characters, stored apart from database backups.
# NOTIFICATION_QUARANTINE_KEY=
# NOTIFICATION_PREFETCH=10
# NOTIFICATION_BATCH_SIZE=5

# --- Author tools, funnels and broadcasts ------------------------------------
# Author permission check. Both absent: author menu and communications API fail closed.
# Secret equals Platform TELEGRAM_AUTHOR_AUTHORIZATION_SECRET.
# PLATFORM_AUTHOR_AUTHORIZATION_URL=https://platform.example.test/integrations/telegram/v1/communications/authorize
# PLATFORM_AUTHOR_AUTHORIZATION_SECRET=
# Required for author-menu funnel preview/publication; uses the author authorization secret.
# PLATFORM_AUTHOR_CONTENT_VALIDATION_URL=https://platform.example.test/integrations/telegram/v1/communications/validate-content
# Funnels and marketing entry. Enabling in production is a separate owner release gate.
TELEGRAM_MARKETING_ENABLED=false
# Optional tracked links through the Platform public visit route (Platform communications-v1).
# The origin equals Platform TELEGRAM_TRACKING_ORIGIN; prefixes are Platform content routes.
# PLATFORM_TRACKING_REDIRECT_URL=https://platform.example/communications/visit
# PLATFORM_TRACKING_TARGET_PREFIXES=["https://platform.example/materials/","https://platform.example/series/"]

# --- Operator commands only (not read by the application) ---------------------
# Credentialed proof values live only in the ignored local .env.
# TELEGRAM_PROOF_BOT_ID=
# TELEGRAM_PROOF_BOT_USERNAME=
# TELEGRAM_PROOF_MINIMUM_ADMIN_CONFIRMED=true
# TELEGRAM_PROOF_OBSERVED_ADMIN_RIGHTS_ACCEPTED=true
# TELEGRAM_PROOF_RETRY_MARKER=
# TELEGRAM_PROOF_DISPOSAL_STATE=
# TELEGRAM_PROOF_TEMPORARY_RESOURCES_DISPOSED=true
# TELEGRAM_PROOF_WEBHOOK_URL=
