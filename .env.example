DATABASE_URL=postgresql://inside:inside@127.0.0.1:5433/inside_telegram
HOST=127.0.0.1
PORT=3002
PLATFORM_INTEGRATION_SECRET=replace_with_separate_random_secret
PLATFORM_EVIDENCE_DELIVERY_MODE=disabled
TELEGRAM_BOT_IDENTITY=inside
TELEGRAM_CANONICAL_CHAT_ID=-1000000000000
TELEGRAM_DELIVERY_MODE=disabled
TELEGRAM_SIGN_IN_ENABLED=false
# Required only when sign-in is enabled; distinct from PLATFORM_INTEGRATION_SECRET.
# TELEGRAM_SIGN_IN_INTEGRATION_SECRET=
TELEGRAM_LINK_RECEIPT_TEXT=Link request received. Return to Platform to continue.
TELEGRAM_LINKED_MEMBER_TEXT=Telegram linked. Membership check sent to Platform.
TELEGRAM_LINKED_NON_MEMBER_TEXT=Telegram linked. Membership is not active in the Inside chat.
TELEGRAM_LINKED_UNAVAILABLE_TEXT=Telegram linked. Membership check is temporarily unavailable.
TELEGRAM_COMMUNITY_MODE=disabled
TELEGRAM_COMMUNITY_RECONCILIATION_CADENCE_MS=60000
# Private-chat wording for /community. Defaults are Russian; owner owns the final copy.
# TELEGRAM_COMMUNITY_INVITE_TEXT=
# TELEGRAM_COMMUNITY_PREPARING_TEXT=
# TELEGRAM_COMMUNITY_MEMBER_TEXT=
# TELEGRAM_COMMUNITY_UNAVAILABLE_TEXT=
TELEGRAM_MEMBERSHIP_MODE=disabled
TELEGRAM_MEMBERSHIP_RECONCILIATION_CADENCE_MS=240000
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
TELEGRAM_WELCOME_TEXT=Welcome to Sachkov Inside.
WORKERS_ENABLED=true

# Community entitlements. The endpoint fails closed without its own secret, and
# TELEGRAM_COMMUNITY_MODE=live additionally needs a bot token and the dispatch check.
# Each secret is separate; no other caller inherits community authority.
# PLATFORM_COMMUNITY_INTEGRATION_SECRET=
# PLATFORM_COMMUNITY_DISPATCH_URL=https://platform.example.test/internal/billing-dispatch/authorize
# PLATFORM_COMMUNITY_DISPATCH_SECRET=

# Required when TELEGRAM_DELIVERY_MODE=live, TELEGRAM_MEMBERSHIP_MODE=live or
# TELEGRAM_COMMUNITY_MODE=live.
# Live Telegram access remains an owner gate.
# TELEGRAM_BOT_TOKEN=
# Owner-assisted proof only; values stay in ignored .env.
# TELEGRAM_PROOF_BOT_ID=
# TELEGRAM_PROOF_BOT_USERNAME=
# TELEGRAM_PROOF_MINIMUM_ADMIN_CONFIRMED=true
# TELEGRAM_PROOF_OBSERVED_ADMIN_RIGHTS_ACCEPTED=true
# TELEGRAM_PROOF_RETRY_MARKER=
# TELEGRAM_PROOF_DISPOSAL_STATE=
# TELEGRAM_PROOF_TEMPORARY_RESOURCES_DISPOSED=true
# TELEGRAM_PROOF_WEBHOOK_URL=

# Required only when PLATFORM_EVIDENCE_DELIVERY_MODE=live.
# PLATFORM_EVIDENCE_DELIVERY_URL=https://platform.example.test/integrations/telegram/v1/membership-evidence
# PLATFORM_EVIDENCE_DELIVERY_SECRET=

# Optional author permission check. Both absent: author intake/API fails closed.
# Platform #307 owns this service-authenticated operation; live setup requires owner approval.
# PLATFORM_AUTHOR_AUTHORIZATION_URL=https://platform.example.test/integrations/telegram/v1/communications/authorize
# PLATFORM_AUTHOR_AUTHORIZATION_SECRET=
# Required for author-menu funnel preview/publication; uses the author authorization secret.
# PLATFORM_AUTHOR_CONTENT_VALIDATION_URL=https://platform.example.test/integrations/telegram/v1/communications/validate-content

# Enable only after owner-authored intro/default funnel and the separate marketing release gate.
TELEGRAM_MARKETING_ENABLED=false

# Optional Platform redirect consumer. Configure both only after consumer rollout.
# PLATFORM_TRACKING_REDIRECT_URL=https://platform.example/communications/go
# PLATFORM_TRACKING_TARGET_PREFIXES=["https://platform.example/materials/","https://platform.example/series/"]
