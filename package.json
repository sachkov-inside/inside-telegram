{
  "name": "@inside/telegram",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm guardrails && pnpm test && pnpm build",
    "check:full": "pnpm check && pnpm test:integration",
    "conformance:communications-provider": "tsx scripts/communications-conformance-provider.ts",
    "conformance:platform-provider": "tsx scripts/platform-conformance-provider.ts",
    "credentialed-proof:probe": "tsx src/operations/run-credentialed-proof.ts",
    "credentialed-proof:preflight": "tsx src/operations/run-credentialed-proof-preflight.ts",
    "credentialed-proof:wizard": "bash scripts/credentialed-proof-wizard.sh",
    "db:migrate": "tsx src/database/migrate.ts",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guardrails": "node scripts/check-architecture.mjs",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d --wait postgres rabbitmq",
    "owner:recover-identity": "tsx src/operations/recover-identity-link.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proof:course:provider": "tsx test/local/course-activation-provider.ts",
    "owner:community-restriction": "tsx src/operations/community-restriction-cli.ts",
    "proof:course:browser": "tsx test/local/course-activation-browser.ts",
    "proof:course:existing": "node test/local/course-existing-browser.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "2.0.1",
    "fastify": "5.12.5",
    "grammy": "1.46.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nestjs/testing": "12.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
